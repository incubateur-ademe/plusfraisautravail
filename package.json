{
  "name": "plusfraisautravail",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for plusfraisautravail.beta.gouv.fr - API gateway, frontends, scripts.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:autodiag": "npm run dev --workspace @pfat/autodiag",
    "dev:alert-widget": "npm run dev --workspace @pfat/alert-widget",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@creedengo/eslint-plugin": "^3.1.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
