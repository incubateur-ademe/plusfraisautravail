{
  "name": "plusfraisautravail",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for plusfraisautravail.beta.gouv.fr - API gateway, frontends, scripts.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev:autodiag": "npm run dev --workspace @pfat/autodiag",
    "dev:alert-widget": "npm run dev --workspace @pfat/alert-widget",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "test:e2e": "npm run test --workspace @pfat/e2e",
    "build-storybook": "npm run build-storybook --workspaces --if-present",
    "pretest:spa": "npm run build-storybook && npm run build --workspace @pfat/autodiag",
    "test:spa": "npm run test:spa --workspace @pfat/e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@creedengo/eslint-plugin": "^3.1.0",
    "@eslint/js": "^9.39.1",
    "@storybook/react-vite": "^10.6.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "storybook": "^10.6.7",
    "typescript-eslint": "^8.48.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
