{
  "name": "@pfat/autodiag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && BUILD_TARGET=embed vite build",
    "build:embed": "tsc -b && BUILD_TARGET=embed vite build",
    "preview:embed": "npm run build:embed && cp dist/autodiag-embed.js test-embed/ && npx serve test-embed -p 4173",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet -o ../../e2e/.cache/storybook/autodiag"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.31.1",
    "@sentry/react": "^11.12.0",
    "js-yaml": "^4.1.1",
    "publicodes": "^1.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
