msgid "An item cannot be moved under itself or one of its descendants."
msgstr "Un élément ne peut pas être déplacé sous lui-même ou sous l’un de ses descendants."

msgid "Place in the tree"
msgstr "Place dans l’arborescence"

msgid ""
"Drag an item onto another one to nest it under it, or between two items to "
"move it there."
msgstr ""
"Glissez un élément sur un autre pour l’imbriquer dessous, ou entre deux "
"éléments pour le déplacer à cet endroit."

#, python-format
msgid ""
"Drag an item onto another one to nest it under it, or outside the list to "
"bring it back to the root. Items are sorted by %(fields)s and cannot be "
"reordered by hand."
msgstr ""
"Glissez un élément sur un autre pour l’imbriquer dessous, ou en dehors de la "
"liste pour le ramener à la racine. Les éléments sont triés par %(fields)s et "
"ne peuvent pas être réordonnés à la main."

#, python-format
msgid "“%(node)s” moved under “%(target)s”."
msgstr "« %(node)s » déplacé sous « %(target)s »."

#, python-format
msgid "“%(node)s” moved next to “%(target)s”."
msgstr "« %(node)s » déplacé au même niveau que « %(target)s »."
