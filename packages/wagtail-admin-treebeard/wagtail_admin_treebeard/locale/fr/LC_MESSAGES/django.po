msgid "An item cannot be moved under itself or one of its descendants."
msgstr "Un élément ne peut pas être déplacé sous lui-même ou sous l’un de ses descendants."

msgid "Place in the tree"
msgstr "Place dans l’arborescence"

msgid ""
"Drag an item onto another one to nest it under it, or onto the zone below to "
"bring it back to the root."
msgstr ""
"Glissez un élément sur un autre pour l’imbriquer dessous, ou sur la zone "
"ci-dessous pour le ramener à la racine."

msgid "Root level"
msgstr "Racine"

#, python-format
msgid "“%(node)s” moved under “%(target)s”."
msgstr "« %(node)s » déplacé sous « %(target)s »."

#, python-format
msgid "“%(node)s” moved to the root."
msgstr "« %(node)s » déplacé à la racine."
